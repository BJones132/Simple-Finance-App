@page "/login"
@using System.ComponentModel.DataAnnotations
@inject AuthService authService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navManager

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<Layout Height="Height.Vh(100)"
        TextAlignment="TextAlignment.Center">
    <LayoutHeader Background="Background.Primary" TextColor="TextColor.White" Padding="Padding.Is3">
        <Div Width="Width.Is100"
             Flex="Flex.JustifyContent.Between.AlignItems.Center"
             Gap="Gap.Is3">
            <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
                <Button Color="Color.Light" Type="ButtonType.Link" href="/" Disabled="@formBusy">
                    <Icon Name="IconName.ArrowLeft" />
                </Button>
            </Div>
        </Div>
    </LayoutHeader>
    <LayoutContent Flex="Flex.Column.JustifyContent.Center.AlignContent.Center.AlignItems.Center">
        <Card Flex="Flex.Column" Width="Width.Is33.OnDesktop.Is66.OnMobile">
            <CardBody>
                <CardTitle Size="HeadingSize.Is3">
                    Welcome Back!
                </CardTitle>
                <EditForm Model="@logindto" FormName="LoginForm">
                    <Validations @ref="validations" Mode="ValidationMode.Manual" Model="@logindto">
                        <Validation>
                            <Field>
                                <FieldLabel>Username:</FieldLabel>
                                <FieldBody>
                                    <TextInput Placeholder="Username" @bind-Value="@logindto!.username" Disabled="@formBusy" onchange="@ClearValidations">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextInput>
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Validation>
                            <Field>
                                <FieldLabel>Password:</FieldLabel>
                                <FieldBody>
                                    <TextInput Role="TextRole.Password" Placeholder="Password" @bind-Value="@logindto!.password" Disabled="@formBusy" onchange="@ClearValidations">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextInput>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Validations>
                    <Button Color="Color.Primary" Type="ButtonType.Submit" PreventDefaultOnSubmit Loading="@formBusy" Disabled="@formBusy" onclick="@TryLogin">
                        @if (!formBusy) {
                            <Span>Login</Span>
                        }
                    </Button>
                </EditForm>
                @if (!string.IsNullOrEmpty(authErrorMessage))
                {
                    <Span TextColor="TextColor.Danger">@authErrorMessage</Span>
                }
            </CardBody>
        </Card>
    </LayoutContent>
</Layout>

@code {
    private bool formBusy = false;
    private string authErrorMessage = string.Empty;
    private Validations validations;

    [SupplyParameterFromForm]
    private LoginDTO logindto { get; set; }

    protected override void OnInitialized()
    {
        if (logindto is null)
            logindto = new LoginDTO();
    }

    protected override async Task OnInitializedAsync()
    {
        string? token = (await protectedLocalStorage.GetAsync<string>("access_token")).Value;
        if (!string.IsNullOrEmpty(token))
        {
            try
            {
                await authService.Get_IDAsync(token);
                navManager.NavigateTo("/user");
            }
            catch (ApiException)
            {
                await protectedLocalStorage.DeleteAsync("access_token");
            }
        }
    }

    private async Task ClearValidations()
    {
        await validations.ClearAll();
    }

    private async Task TryLogin() {
        authErrorMessage = string.Empty;
        formBusy = true;
        if(!await validations.ValidateAll())
        {
            formBusy = false;
            return;
        }

        try
        {
            Token token = await authService.AuthenticateAsync(new UserDTO { Username = logindto.username, Password = logindto.password });
            await protectedLocalStorage.SetAsync("access_token", token.Access_token);
            navManager.NavigateTo("/user");
        }
        catch (ApiException)
        {
            authErrorMessage = "Incorrect Username or Password!";
            formBusy = false;
            return;
        }
    }

    public class LoginDTO{
        [Required(ErrorMessage = "Username is requried")]
        public string? username{ get; set; }
        [Required(ErrorMessage = "Password is required")]
        [DataType(DataType.Password)]
        public string? password{ get; set; }
    }
}
