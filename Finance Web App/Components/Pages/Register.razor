@page "/register"
@using System.ComponentModel.DataAnnotations
@inject AuthService authService
@inject AccountService accountService
@inject TransactionService transactionService
@inject ProtectedLocalStorage protectedLocalStorage
@inject NavigationManager navManager

@rendermode @(new InteractiveServerRenderMode(prerender: false))

<Layout Height="Height.Vh(100)"
        TextAlignment="TextAlignment.Center">
    <LayoutHeader Background="Background.Primary" TextColor="TextColor.White" Padding="Padding.Is3">
        <Div Width="Width.Is100"
             Flex="Flex.JustifyContent.Between.AlignItems.Center"
             Gap="Gap.Is3">
            <Div Flex="Flex.AlignItems.Center" Gap="Gap.Is2">
                <Button Color="Color.Light" Type="ButtonType.Link" href="/" Disabled="@formBusy">
                    <Icon Name="IconName.ArrowLeft" />
                </Button>
            </Div>
        </Div>
    </LayoutHeader>
    <LayoutContent Flex="Flex.Column.JustifyContent.Center.AlignContent.Center.AlignItems.Center">
        <Card Flex="Flex.Column" Width="Width.Is33.OnDesktop.Is66.OnMobile">
            <CardBody>
                <CardTitle Size="HeadingSize.Is3">
                    Sign Up
                </CardTitle>
                <EditForm Model="@registerdto" FormName="RegisterForm">
                    <Validations @ref="validations" Mode="ValidationMode.Manual" Model="@registerdto">
                        <Validation>
                            <Field>
                                <FieldLabel>Username:</FieldLabel>
                                <FieldBody>
                                    <TextInput Placeholder="Username" @bind-Value="@registerdto!.Username" Disabled="@formBusy" onchange="@ClearValidations">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextInput>
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Validation>
                            <Field>
                                <FieldLabel>Password:</FieldLabel>
                                <FieldBody>
                                    <TextInput Role="TextRole.Password" Placeholder="Password" @bind-Value="@registerdto!.Password" Disabled="@formBusy" onchange="@ClearValidations">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextInput>
                                </FieldBody>
                            </Field>
                        </Validation>
                        <Validation>
                            <Field>
                                <FieldLabel>Confirm Password:</FieldLabel>
                                <FieldBody>
                                    <TextInput Role="TextRole.Password" Placeholder="Confirm Password" @bind-Value="@registerdto!.ConfirmPassword" Disabled="@formBusy" onchange="@ClearValidations">
                                        <Feedback>
                                            <ValidationError />
                                        </Feedback>
                                    </TextInput>
                                </FieldBody>
                            </Field>
                        </Validation>
                    </Validations>
                    <Button Color="Color.Primary" Type="ButtonType.Submit" PreventDefaultOnSubmit Loading="@formBusy" Disabled="@formBusy" onclick="@TryRegister">
                        @if (!formBusy)
                        {
                            <Span>Register</Span>
                        }
                    </Button>
                </EditForm>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <Span TextColor="TextColor.Danger">@errorMessage</Span>
                }
            </CardBody>
        </Card>
    </LayoutContent>
</Layout>

@code {
    private bool formBusy = false;
    private string errorMessage = string.Empty;
    private Validations validations;

    [SupplyParameterFromForm]
    private RegisterDTO? registerdto { get; set; }

    protected override void OnInitialized()
    {
        if (registerdto is null)
            registerdto = new RegisterDTO();
    }

    private async Task ClearValidations()
    {
        await validations.ClearAll();
    }

    private async Task TryRegister()
    {
        errorMessage = string.Empty;
        formBusy = true;
        if (!await validations.ValidateAll())
        {
            formBusy = false;
            return;
        }

        try
        {
            Finance_Web_App.User newUser = await authService.Register_UserAsync(new UserDTO() 
                                { 
                                    Username = registerdto!.Username,
                                    Password = registerdto!.Password 
                                });

            Account newAccount = await accountService.AddAccountAsync(new AddAccountDTO() { User_id = newUser.Id });
            await accountService.AddBalanceAsync(newAccount.Id, 1000);
            await transactionService.CreateTransactionAsync(new TransactionDTO() { SourceAccountId = 0, DestinationAccountId = newAccount.Id, Designator = "Seed", Reference = "Seed Balance", Amount = 1000, DestinationBalance = 1000 });

            navManager.NavigateTo("/login");
        }
        catch (ApiException)
        {
            errorMessage = "A problem has occurred!";
            formBusy = false;
            return;
        }
    }

    public class RegisterDTO
    {
        [Required(ErrorMessage = "Username is requried")]
        public string? Username { get; set; }
        [Required(ErrorMessage = "Password is required")]
        [DataType(DataType.Password)]
        public string? Password { get; set; }
        [Required(ErrorMessage = "Confirm Password is required")]
        [DataType(DataType.Password)]
        [Compare("Password")]
        public string? ConfirmPassword { get; set; }
    }
}
